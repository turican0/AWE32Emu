+                fr, c, v->ccca, v->cpf, v->ptrx, v->cvcf, v->vtft, v->psst, v->csl, v->ip, v->ifatn, v->pefe,
+                v->fmmod, v->tremfrq, v->fm2frq2, v->envvol, v->dcysusv, v->atkhldv, v->envval, v->dcysus,
