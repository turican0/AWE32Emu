+            emu8k->rv_echo_d[ch] = e->d[ch];
+            emu8k->rv_echo_c[ch] = e->c[ch];
+            emu8k->rv_echo_g[ch] = e->g[ch];
+        }
+        emu8k->rv_echo_pos = 0;
+        memset(emu8k->rv_echo_x, 0, sizeof(emu8k->rv_echo_x));
+        memset(emu8k->rv_echo_z, 0, sizeof(emu8k->rv_echo_z));
