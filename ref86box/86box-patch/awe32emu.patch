+/* One decay/release step: ramp_amount_db_oct is Q16. */
+static inline int32_t
+emu8k_ramp_step(emu8k_envelope_t *env)
+{
+    const int64_t s = (int64_t) env->ramp_amount_db_oct + env->ramp_frac;
+    env->ramp_frac  = (int32_t) (s & 0xFFFF);
+    return (int32_t) (s >> 16);
+}
