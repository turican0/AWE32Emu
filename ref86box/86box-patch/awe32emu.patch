+/* AWE32Emu: local addition, not upstream.
+ *
+ *  86Box cannot save its own sound output to a file. To compare with what a
+ *  program in the guest records itself, a reference is needed - what really
+ *  came out of the EMU8000. With the variable AWE_WAVOUT set, the wavetable
+ *  output is written here continuously as a 16-bit stereo WAV at WT_FREQ.
+ *  Without the variable nothing happens.
+ * ------------------------------------------------------------------------- */
+static FILE    *awe_wavout       = NULL;
+static uint32_t awe_wavout_bytes = 0;
+static int      awe_wavout_state = 0;   /* 0 = undecided, 1 = running, -1 = off */
+
+static void
+awe_wavout_header(FILE *f, uint32_t data_bytes)
+{
+    const uint32_t rate  = WT_FREQ;
+    const uint16_t chans = 2;
+    const uint16_t bits  = 16;
+    const uint32_t byte_rate   = rate * chans * (bits / 8);
+    const uint16_t block_align = chans * (bits / 8);
+    uint32_t       u32;
+    uint16_t       u16;
+
+    fseek(f, 0, SEEK_SET);
+    fwrite("RIFF", 1, 4, f);
+    u32 = 36 + data_bytes;              fwrite(&u32, 4, 1, f);
+    fwrite("WAVEfmt ", 1, 8, f);
+    u32 = 16;                           fwrite(&u32, 4, 1, f);
+    u16 = 1;                            fwrite(&u16, 2, 1, f);
+    u16 = chans;                        fwrite(&u16, 2, 1, f);
+    u32 = rate;                         fwrite(&u32, 4, 1, f);
+    u32 = byte_rate;                    fwrite(&u32, 4, 1, f);
+    u16 = block_align;                  fwrite(&u16, 2, 1, f);
+    u16 = bits;                         fwrite(&u16, 2, 1, f);
+    fwrite("data", 1, 4, f);
+    u32 = data_bytes;                   fwrite(&u32, 4, 1, f);
+}
+
+static void
+awe_wavout_write(const int32_t *buf, uint32_t samples)
+{
+    int16_t  frame[2];
+    uint32_t c;
+
+    if (awe_wavout_state == 0) {
+        const char *name = getenv("AWE_WAVOUT");
+
+        awe_wavout_state = -1;
+        if ((name != NULL) && (name[0] != '\0')) {
+            awe_wavout = fopen(name, "wb");
+            if (awe_wavout != NULL) {
+                awe_wavout_header(awe_wavout, 0);
+                awe_wavout_state = 1;
+            }
+        }
+    }
+    if (awe_wavout_state != 1)
+        return;
+
+    for (c = 0; c < samples; c += 2) {
+        int32_t l = buf[c];
+        int32_t r = buf[c + 1];
+
+        if (l > 32767) l = 32767; else if (l < -32768) l = -32768;
+        if (r > 32767) r = 32767; else if (r < -32768) r = -32768;
+
+        frame[0] = (int16_t) l;
+        frame[1] = (int16_t) r;
+        fwrite(frame, 2, 2, awe_wavout);
+        awe_wavout_bytes += 4;
+    }
+
+    /* The header is rewritten after every block, so the file is usable even
+       when the emulator does not end cleanly. */
+    awe_wavout_header(awe_wavout, awe_wavout_bytes);
+    fseek(awe_wavout, 0, SEEK_END);
+}
