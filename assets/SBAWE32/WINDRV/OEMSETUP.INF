
[disks]
    1 =. ,"Creative Sound Blaster AWE32 Drivers",disk1

[Installable.Drivers]
SBAWE32   = 1:sbawe32.drv,  "MIDI",      "Sound Blaster AWE32 MIDI Driver", 1:vsbpd.386,,
SB16FM      = 1:sb16fm.drv,  "MIDI",      "Voyetra / Sound Blaster SuperSAPI FM Driver", 1:vsbpd.386,,
SB16Aux      = 1:sb16aux.drv,  "AUX",	    "Creative Sound Blaster 16 Auxiliary Audio", 1:vsbpd.386,,
SB16WaveMidi   = 1:sb16snd.drv,  "Wave,MIDI", "Creative Sound Blaster 16 Wave and MIDI", 1:vsbpd.386,,

[SBAWE32]
1:midimap.cfg

[SB16FM]
1:midimap.cfg

[SB16WaveMidi]
1:cspman.dll
